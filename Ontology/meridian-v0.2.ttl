@prefix mer:  <https://meridian.sotofranco.dev/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#
# Meridian Ontology — v0.2
#
# Extends v0.1 (meridian.ttl). v0.1 stays valid forever; v0.2 adds:
#   * mer:sourceLoc       — `file:line:col` per Declaration
#   * mer:docstring       — raw /-- ... -/ comment body per Declaration
#   * mer:typeSignature   — pretty-printed Lean type per Declaration
#   * mer:complete        — last-triple sentinel proving the writer finished
# and locks down:
#   * IRI encoding rule: `<.../<percent-encoded-path>#<percent-encoded-name>>`
#     where each segment is RFC 3987 percent-encoded. `#` inside a Lean name
#     encodes to `%23`.
#   * `owl:versionInfo "0.2.0"` MUST appear in every v0.2 dump's preamble.
#

<https://meridian.sotofranco.dev/ontology>
  a owl:Ontology ;
  dct:title "Meridian Ontology"@en ;
  owl:versionInfo "0.2.0" ;
  dct:description "Vocabulary for Lean 4 declaration knowledge graphs."@en ;
  dct:creator "Alejandro Jose Soto Franco" .

mer:sourceLoc a owl:DatatypeProperty ;
  rdfs:domain mer:Declaration ;
  rdfs:range  xsd:string ;
  rdfs:label "source location"@en ;
  rdfs:comment "Module-relative file:line:col where the decl is defined. Line is 1-based, col is 0-based (matches Lean's internal convention). Absent if unavailable." @en .

mer:docstring a owl:DatatypeProperty ;
  rdfs:domain mer:Declaration ;
  rdfs:range  xsd:string ;
  rdfs:label "docstring"@en ;
  rdfs:comment "Body of the `/-- ... -/` comment attached to the decl, raw, no markdown normalisation. Absent if no docstring." @en .

mer:typeSignature a owl:DatatypeProperty ;
  rdfs:domain mer:Declaration ;
  rdfs:range  xsd:string ;
  rdfs:label "type signature"@en ;
  rdfs:comment "Pretty-printed Lean type expression. Absent if unavailable or too large to render." @en .

mer:complete a owl:DatatypeProperty ;
  rdfs:domain mer:Dump ;
  rdfs:range  xsd:boolean ;
  rdfs:label "complete"@en ;
  rdfs:comment "Presence of this triple as the last in the file proves the writer finished cleanly. Consumers detecting its absence treat the dump as partial." @en .
